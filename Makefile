# NEXUS developer targets. Python is the standard library only for these targets.
PYTHON ?= python3

.PHONY: index lint-runbooks eval-retrieval results

# Spec section 15, phase 3: lint, ingest, index. Writes build/index/{index,manifest}.json.
index:
	$(PYTHON) -m experiments.harness.rag index --out build/index runbooks

lint-runbooks:
	$(PYTHON) -m experiments.harness.rag lint runbooks

# Spec section 15, "Retrieval evaluation". Rewrites experiments/retrieval/results.json.
eval-retrieval:
	$(PYTHON) -m experiments.harness.rag eval --write experiments/retrieval/results.json

# Spec section 25: every Chapter 5 table and figure from exported runs, without a cluster. The
# defaults are the committed FIXTURE runs (experiments/analysis/sample, regenerated by
# `python3 -m experiments.analysis.sample_data experiments/analysis/sample`); for the study:
#   make results RUNS=experiments/runs TRUTH=experiments/ground-truth.json SUITE=<suite.json>
RUNS ?= experiments/analysis/sample/runs
TRUTH ?= experiments/analysis/sample/ground-truth.json
SUITE ?= experiments/analysis/sample/suite.json
RESULTS ?= build/results

results:
	$(PYTHON) -m experiments.analysis.results --runs $(RUNS) --truth $(TRUTH) --suite $(SUITE) \
	    --retrieval experiments/retrieval/results.json --out $(RESULTS)
